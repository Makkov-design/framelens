{
  "name": "framelens",
  "version": "2.1.0",
  "description": "Frame Lens: eyes and ears for any video or animation. Measured transcripts, frames, cuts, easing, palette and beats, and starter projects for HyperFrames, Remotion, CSS, After Effects and Lottie.",
  "author": {
    "name": "Makkov",
    "url": "https://github.com/Makkov-design"
  },
  "homepage": "https://github.com/Makkov-design/framelens",
  "repository": "https://github.com/Makkov-design/framelens",
  "license": "MIT",
  "keywords": [
    "video",
    "motion-design",
    "animation",
    "youtube",
    "transcript",
    "mcp"
  ],
  "mcpServers": {
    "framelens": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/framelens.mjs"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "GEMINI_MODEL_NAME": "${GEMINI_MODEL_NAME:-gemini-flash-lite-latest}"
      }
    }
  }
}
