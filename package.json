{
  "name": "framelens",
  "version": "2.1.0",
  "mcpName": "io.github.Makkov-design/framelens",
  "description": "Eyes and ears for AI agents: measured analysis of any video or animation (frames, cuts, easing, palette, beats, transcripts) and starter projects for HyperFrames, Remotion, CSS, After Effects and Lottie. MCP server.",
  "type": "module",
  "bin": {
    "framelens": "dist/framelens.mjs"
  },
  "files": [
    "dist/framelens.mjs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p extension/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run bundle",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "video",
    "video-analysis",
    "motion-design",
    "animation",
    "easing",
    "youtube",
    "transcript",
    "ffmpeg",
    "lottie",
    "remotion",
    "hyperframes",
    "gemini"
  ],
  "author": "Makkov",
  "license": "MIT",
  "homepage": "https://github.com/Makkov-design/framelens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Makkov-design/framelens.git"
  },
  "bugs": {
    "url": "https://github.com/Makkov-design/framelens/issues"
  },
  "devDependencies": {
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
